APP_NAME="Tu Radio Online"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://turadioonline.localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

# The three hosts of the platform: listeners, creators' console and platform staff.
# Locally *.localhost resolves to 127.0.0.1 in every modern browser.
PUBLIC_HOST=turadioonline.localhost
STUDIO_HOST=consola-fullradio.localhost
CONTROL_HOST=control-turadioonline.localhost
PUBLIC_URL=http://turadioonline.localhost:8000
STUDIO_URL=http://consola-fullradio.localhost:8000
CONTROL_URL=http://control-turadioonline.localhost:8000
PLATFORM_TIMEZONE=America/Lima
DIAL_SIZE=500

# First super administrator, created by `php artisan db:seed`. It signs in to the control
# panel with SUPERADMIN_USERNAME and SUPERADMIN_PASSWORD (listeners and creators use Google).
SUPERADMIN_NAME=
SUPERADMIN_USERNAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite. Production uses Supabase Postgres in its own schema,
# so the tables are not exposed through the Supabase Data API:
# DB_CONNECTION=pgsql
# DB_HOST=aws-1-us-west-2.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=
# DB_SEARCH_PATH=turadio
# DB_SSLMODE=require
# DB_PERSISTENT=true
# DB_EMULATE_PREPARES=true
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production: "redis" (dispatching a job or a broadcast costs no database round trip).
QUEUE_CONNECTION=database
# Production: "media" (long ffmpeg renders run on their own worker, see deploy/install.sh).
QUEUE_MEDIA_CONNECTION=

# Production: "redis". Sessions are read from the cache and the roles of each account are
# kept there, so a remote database is only asked for what each page shows.
CACHE_STORE=database
# Production: Redis on the VPS itself (deploy/redis.sh), only on 127.0.0.1.
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6380

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@turadioonline.miacademiapreu.com"
MAIL_FROM_NAME="${APP_NAME}"

# Every media file lives in Wasabi. Without WASABI_BUCKET files stay on the local disks.
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_REGION=us-central-1
WASABI_BUCKET=
WASABI_ENDPOINT=https://s3.us-central-1.wasabisys.com
WASABI_PREFIX=
# Optional CA bundle (path relative to the project) when the system has none, e.g. on Windows.
WASABI_CA_BUNDLE=

# Studio media: ffmpeg renders the audio editor; song identification asks free music databases.
FFMPEG_BINARY=ffmpeg
MUSIC_LOOKUP_USER_AGENT=
MUSIC_LOOKUP_COUNTRY=US
# Genre given (as a guess) to songs nothing classifies; leave empty for none.
MUSIC_FALLBACK_GENRE="Música variada"

# Deposits: "sandbox" credits at once (local only), "culqi" charges real cards with Culqi Checkout.
PAYMENTS_DRIVER=sandbox
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_CURRENCY=USD
# Deducted from every gift and highlighted message (the station receives the rest).
PROCESSOR_FEE_PERCENT=5
PLATFORM_FEE_PERCENT=10
# Frequencies for sale: the card processor fee (Culqi), the platform commission, the tax (IGV)
# charged on that commission, and the lowest price, in cents. The seller gets the rest.
FREQUENCY_SALE_PROCESSOR_FEE_PERCENT=5
FREQUENCY_SALE_FEE_PERCENT=10
FREQUENCY_SALE_TAX_PERCENT=18
FREQUENCY_SALE_MIN_PRICE_CENTS=5000
# Audience integrity: a subscription counts once the account is this old (hours) and has listened
# this long (seconds); guests count up to this many players per network (IP) in the live audience.
INTEGRITY_SUBSCRIBER_ACCOUNT_HOURS=24
INTEGRITY_SUBSCRIBER_LISTEN_SECONDS=120
INTEGRITY_GUESTS_PER_NETWORK=4

# Sign in with Google (OAuth client of Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Live microphone over WebRTC: a TURN relay for listeners behind strict networks.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
STREAMING_VERIFY_FILES=true

# Realtime (Laravel Reverb). Set BROADCAST_CONNECTION=reverb and run `php artisan reverb:start`.
# REVERB_HOST/PORT/SCHEME is where Laravel publishes (127.0.0.1:8080 on the server); browsers
# connect to the host that served the page, which proxies /app to Reverb.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
